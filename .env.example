# Optional. Only needed in production if the client and the API server are
# deployed on different domains (e.g. client on Netlify, server on Render).
#
# Leave unset for local development — vite.config.js already proxies
# /api requests to the backend on http://localhost:5000.
#
# Example:
# VITE_API_URL=https://api.dcplumbingsolutions.com
VITE_API_URL=
